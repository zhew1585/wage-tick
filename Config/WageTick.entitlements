<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 只给本地与 CI 的 ad-hoc 构建用：ad-hoc 签名没有 Team ID，hardened runtime 默认只加载同一 Team ID 签名的框架，Sparkle.framework 会被拒 (ADR-0007)。
	     发布时 scripts/ci/codesign-app.sh 用 Developer ID 重签并去掉这一项，正式版开着库校验 (ADR-0009)。 -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
